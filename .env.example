# Required: API key for your OpenAI-compatible endpoint
OPENAI_API_KEY=replace-me

# Use the endpoint's OpenAI-compatible API URL and a model that supports image input.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Request and parsing limits
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
PDF_RENDER_DPI=150
# Per-attempt read timeout; the SDK may retry timed-out requests twice.
OPENAI_TIMEOUT_SECONDS=300
